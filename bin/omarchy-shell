#!/bin/bash
# Drop-in for Omarchy's `omarchy-shell [-q] <target> <method> [args...]`.
# Talks to the running mac host over its unix socket using the same wire
# protocol as upstream (unit-separated fields, record-separated messages).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$ROOT/bin/omarchy-shell-mac" ipc "$@"
